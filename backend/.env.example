# MongoDB URL - Update with your MongoDB credentials
MONGO_URL=mongodb://localhost:27017
DB_NAME=afroexperts_erp

# JWT Settings - Change these for production
SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings - Update with your domain
ALLOWED_ORIGINS=http://localhost:3000,https://your_domain.com

# Email Settings (Optional - for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@domain.com
SMTP_PASSWORD=your_app_password

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_FOLDER=uploads